# API Keys for Innovera Research Pre-Step
OPENAI_API_KEY=sk-...              # For GPT Researcher's LLM calls + embeddings
TAVILY_API_KEY=tvly-...            # For GPT Researcher's web search backend
OPENROUTER_API_KEY=sk-or-...       # For context extraction via Claude (OpenRouter)

# Context Extraction Model (via OpenRouter — any model on openrouter.ai)
CONTEXT_LLM_MODEL=anthropic/claude-sonnet-4.6

# GPT Researcher Model Config (uses OPENAI_API_KEY directly)
GPTR_SMART_LLM=openai:gpt-5
GPTR_STRATEGIC_LLM=openai:gpt-5.4
GPTR_FAST_LLM=openai:gpt-5-mini

# Search backend
RETRIEVER=tavily
